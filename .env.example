# Application
HOST=localhost
PORT=8080
ENV=development
DELTA=15

# Required database configuration
MYSQL_DRIVER=mysql
MYSQL_DSN=

# Required in production. Keep real values in a secret manager or local .env.
ADMIN_EMAIL=
ADMIN_PWD=
SESSION_SECRET=

# Kandinsky API
KAND_API_KEY=
KAND_API_SECRET=
KAND_API_URL=
KAND_API_AUTH_URL=
KAND_API_GEN_URL=

# Logging
LOG_LEVEL=development
LOG_FILE=./tmp/log.log
LOG_MAXSIZE=100
LOG_MAXBACKUP=3
LOG_MAXAGE=24
LOG_COMPRESS=true

# TLS
TLS_KEY_PATH=./tls/key.pem
TLS_CERT_PATH=./tls/cert.pem

# SMTP
SMTP_HOST=
SMTP_PORT=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
